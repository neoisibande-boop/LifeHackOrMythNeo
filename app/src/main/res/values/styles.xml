<resources>
    <style name="Theme.LifeHackOrMyth" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/teal</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:windowBackground">@color/paper</item>
    </style>
    <style name="Title">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>
    <style name="Body">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingExtra">5dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>
    <style name="Label" parent="Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/teal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="PrimaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@color/teal</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>
    <style name="SecondaryButton" parent="PrimaryButton">
        <item name="android:backgroundTint">@color/navy</item>
    </style>
</resources>
